# kg-update 本地配置
# 复制此文件为 .env 并修改为你本机的路径

# AI-KG 项目路径（知识图谱管道后端）
KG_PROJECT_DIR=/Users/bo.gong/Documents/accenture/AI应用/AI-KG

# Python 解释器：必须装有 jieba、scikit-learn、PyYAML、networkx、python-frontmatter
# 不要用裸 python3 —— /usr/bin/python3 缺这些依赖，管道会直接 ImportError
KG_PYTHON=/Users/bo.gong/.venvs/ai-kg/bin/python3

# kb-ingest 本地配置
# 复制此文件为 .env，然后按本机情况修改下面每一项路径

# Obsidian Vault 路径（与 addToObsidian / kg-qa 共用同一个）
VAULT_PATH=/path/to/obsidian/vault

# AI-KG 项目路径（kg-update / kg-qa 的后端）
KG_PROJECT_DIR=/path/to/AI-KG

# kg-tools 仓库路径（各子 skill 所在处）
KG_TOOLS_DIR=/path/to/kg-tools

# 全链路统一 Python 解释器。
# 该环境需装齐：jieba、scikit-learn、PyYAML、networkx、python-frontmatter、
# pdfplumber、python-pptx。不要用裸 python3 —— 系统自带的通常一个都没有。
KG_PYTHON=/path/to/venv/bin/python3

# 进度清单目录（kb-ingest-state.json 落在这里）。
# 留空则默认用 <本 skill 目录>/.local/（已 gitignore）。
# 这是运行时状态，不要放进版本管理，也不要放进 SOURCE_ROOTS。
KB_STATE_DIR=

# 长期同步的源文件夹，冒号分隔。--sync 会扫描这些根目录。
# 临时目录用 `/kb-ingest <路径>` 直接指定，不必登记在这里。
# 多个根目录示例：/path/a:/path/b
SOURCE_ROOTS=/path/to/source/folder
